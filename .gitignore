# 依赖
node_modules/

# 上传数据（按需备份，不入库）
uploads/

# 自签证书（每台服务器独立生成）
.certs/

# 日志与临时文件
*.log
*.pid
*.tmp

# 发布产物（npm run pack 生成）
dist/

# 未完成的分块上传暂存（跑起来才生成）
.uploading/

# 无痕传输的密文中转区（跑起来才生成，绝不能入库）
.transfer/
transfer/
.DS_Store
Thumbs.db

# 验证工装（ui-check / mutate / gate-warm / perf-fp）与它们的临时载荷
# 留在盘上方便下次回归，但不进仓库、也不进发布包
.devtmp/

# 环境变量与密钥
.env
.env.*
!.env.example

# 编辑器
.idea/
.vscode/
*.swp