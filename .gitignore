# 依赖
node_modules/

# 上传数据（按需备份，不入库）
uploads/

# 自签证书（每台服务器独立生成）
.certs/

# 日志与临时文件
*.log
*.pid
*.tmp

# 发布产物（npm run pack 生成）
dist/

# 新界面的 Vite 构建产物（npm run build 生成）
dist-web/

# 未完成的分块上传暂存（跑起来才生成）
.uploading/

# 无痕传输的密文中转区（跑起来才生成，绝不能入库）
.transfer/
transfer/

# 下载次数账本（在 uploads 之外，跑起来才生成）
.stats/

# 目录索引（NeDB，在 uploads 之外，跑起来才生成；随 uploads 一起备份）
.library/
.DS_Store
Thumbs.db

# 环境变量与密钥
.env
.env.*
!.env.example

# 编辑器
.idea/
.vscode/
*.swp