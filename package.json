{
  "name": "file-box",
  "version": "1.0.0",
  "description": "轻量文件上传 / 下载服务：批量上传、按时间分组、支持 PC 与移动端",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "setup": "node scripts/setup.js",
    "release": "node scripts/setup.js --pack",
    "dev": "vite --config vite.config.mjs",
    "dev:server": "node server.js",
    "build": "vite build --config vite.config.mjs",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "pack": "npm run build && node scripts/pack.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@formkit/drag-and-drop": "^0.6.1",
    "@seald-io/nedb": "^4.1.2",
    "express": "^4.21.2",
    "selfsigned": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lucide/vue": "^1.61.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vueuse/core": "^14.4.0",
    "fflate": "^0.8.3",
    "reka-ui": "^2.11.0",
    "vite": "^6.4.5",
    "vue": "^3.5.44"
  }
}
